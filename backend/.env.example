APP_ENV=development
SEED_PASSWORD="ganti_dengan_password_dummy"
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
APP_MEMORY_LIMIT_MB=0
TRUST_PROXY_HEADERS=false

# Antrean unggahan: jatah memori semua unggahan sekaligus, batas menunggu giliran, batas waktu
# request unggahan (mengirim file / total). Sesuaikan jatah dengan RAM server (sekitar 5-10%).
UPLOAD_MEMORY_MB=200
UPLOAD_WAIT=60s
UPLOAD_READ_TIMEOUT=2m
UPLOAD_TIMEOUT=3m

DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD="ganti_dengan_password_kuat"
DB_NAME=digioffice
DB_TRUST_SERVER_CERTIFICATE=true

MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_ROOT_USER="ganti_dengan_username"
MINIO_ROOT_PASSWORD="ganti_dengan_password_kuat"

GOTENBERG_URL=http://localhost:3001

# API HC PUSRI (hanya untuk go run ./cmd/sync-hc -api). Isi hanya di .env, jangan di-commit.
PUSRI_HC_ORGANIZATION_URL=
PUSRI_API_TOKEN=

JWT_SECRET="ganti_dengan_string_acak_minimal_32_karakter"
JWT_TTL=8h
CORS_ALLOWED_ORIGINS=http://localhost:3000
