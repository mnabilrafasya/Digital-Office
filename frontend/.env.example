# URL Backend Go
BACKEND_URL=http://localhost:8080

# Password akun seed untuk Akses Cepat Developer (samakan dengan SEED_PASSWORD di backend/.env)
SEED_PASSWORD=

# (Opsional) Kunci lisensi DevExpress RichEdit — lihat DEVEXPRESS_SETUP.md
# Tanpa kunci: editor tetap jalan, muncul watermark "Unlicensed"
NEXT_PUBLIC_DEVEXPRESS_LICENSE_KEY=
